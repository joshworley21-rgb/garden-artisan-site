# Vite inlines VITE_* variables at BUILD time — rebuild after changing them.
#
# These configure the Supabase project the enquiry form used before it moved to
# public/enquiry.php. Nothing in the app imports the Supabase client today, so
# the site builds and runs without them. Keep them only if you plan to use
# Supabase again; the publishable key is safe to expose, a service-role key is not.
VITE_SUPABASE_PROJECT_ID=""
VITE_SUPABASE_PUBLISHABLE_KEY=""
VITE_SUPABASE_URL=""

# Google Analytics 4 and Google Ads conversion tracking. Leave any of these
# empty to disable that half — with all four unset the site loads no tag at all.
#   VITE_GA4_MEASUREMENT_ID     GA4 measurement ID, e.g. G-XXXXXXXXXX
#   VITE_GOOGLE_ADS_ID          Google Ads conversion ID, e.g. AW-123456789
#   VITE_GOOGLE_ADS_*_LABEL     the conversion label Google shows when you
#                               create the action (the part after the slash in
#                               'AW-123456789/AbC-D_efGh'), NOT the whole string
VITE_GA4_MEASUREMENT_ID=""
VITE_GOOGLE_ADS_ID=""
VITE_GOOGLE_ADS_ENQUIRY_LABEL=""
VITE_GOOGLE_ADS_CALL_LABEL=""
