# Vite inlines VITE_* variables at BUILD time — rebuild after changing them.
#
# These configure the Supabase project the enquiry form used before it moved to
# public/enquiry.php. Nothing in the app imports the Supabase client today, so
# the site builds and runs without them. Keep them only if you plan to use
# Supabase again; the publishable key is safe to expose, a service-role key is not.
VITE_SUPABASE_PROJECT_ID=""
VITE_SUPABASE_PUBLISHABLE_KEY=""
VITE_SUPABASE_URL=""

# --- Google Ads conversion tracking -----------------------------------------
# Leave these blank and the site loads no Google tag, sets no cookies and shows
# no consent banner. Fill them in and rebuild to switch tracking on.
#
# VITE_GADS_ID          the conversion ID from Google Ads, e.g. "AW-123456789"
# VITE_GADS_FORM_LABEL  conversion label for the "Enquiry form" action
# VITE_GADS_CALL_LABEL  conversion label for the "Phone click" action
#
# Create both conversion actions in Google Ads under Goals > Conversions >
# New conversion action > Website > "Add manually". Each one gives you a label
# that looks like "AbC-D1efGhIjKlM2n". See marketing/google-ads/README.md.
VITE_GADS_ID=""
VITE_GADS_FORM_LABEL=""
VITE_GADS_CALL_LABEL=""
