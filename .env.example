# Vite inlines VITE_* variables at BUILD time — rebuild after changing them.
#
# These configure the Supabase project the enquiry form used before it moved to
# public/enquiry.php. Nothing in the app imports the Supabase client today, so
# the site builds and runs without them. Keep them only if you plan to use
# Supabase again; the publishable key is safe to expose, a service-role key is not.
VITE_SUPABASE_PROJECT_ID=""
VITE_SUPABASE_PUBLISHABLE_KEY=""
VITE_SUPABASE_URL=""
